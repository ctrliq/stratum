{
  "name": "dash-next",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:cluster": "node scripts/dev-cluster.mjs",
    "build": "tsr generate && tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsr generate && tsc",
    "lint": "eslint . --fix && prettier --write .",
    "lint:css": "stylelint \"src/**/*.{css,scss}\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "generate": "openapi-codegen gen k8s && openapi-codegen gen dashboard && openapi-codegen gen fleet",
    "generate:k8s-spec": "tsx openapi/k8s/subset.ts"
  },
  "dependencies": {
    "@ctrliq/quantic-components": "latest",
    "@ctrliq/quantic-css": "latest",
    "@ctrliq/quantic-fonts": "latest",
    "@ctrliq/quantic-react": "latest",
    "@ctrliq/quantic-tokens": "latest",
    "@tanstack/react-form": "^1.33.0",
    "@tanstack/react-query": "^5.101.2",
    "@tanstack/react-router": "^1.0.0",
    "@tanstack/react-table": "^8.21.3",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "clsx": "^2.1.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "yaml": "^2.9.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@ctrliq/quantic-eslint-config": "latest",
    "@ctrliq/quantic-patterns": "latest",
    "@ctrliq/quantic-playbooks": "latest",
    "@ctrliq/quantic-prettier-config": "latest",
    "@ctrliq/quantic-stylelint-config": "latest",
    "@ctrliq/quantic-tsconfig": "latest",
    "@openapi-codegen/cli": "^3.1.0",
    "@openapi-codegen/typescript": "^11.1.0",
    "@tanstack/react-query-devtools": "^5.101.2",
    "@tanstack/router-cli": "^1.0.0",
    "@tanstack/router-plugin": "^1.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.0.0",
    "eslint": "^10.0.0",
    "prettier": "^3.0.0",
    "sass": "^1.70.0",
    "stylelint": "^17.6.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vite-plugin-static-copy": "^3.0.0",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=24",
    "pnpm": ">=11"
  }
}
