# Generated output.
/staging/
/dist/
/.stamps/
/build-info.json
*.spdx.json
*.sig
*.pem

# A bare `go build -o stratum` drops the binary at the repo root. The Makefile's
# real output is $(DIST)/stratum, already covered by /dist/ above, so this root
# path is only ever a stray local build.
/stratum

# Source files that a common global gitignore would swallow. Both negations
# exist so such a gitignore cannot drop them:
#   *.mod*   -> would drop go.mod
#   /build/  -> would drop the entire build system
!/go.mod
!/go.sum

# build/ holds the pin manifest and the component Dockerfiles — it is source,
# not output. Negated explicitly because a global gitignore with a "/build/"
# rule (a common default) would otherwise silently drop the entire build system
# from every commit.
!/build/

# Generated by tools/ostests/run-conformance.sh: conformance results are
# release-pipeline output, attached to a release, not committed here.
/_output/

# Python bytecode from tools/upstream_sources.py.
__pycache__/
*.pyc

# Renovate reads renovate.json5; a stray renovate.json (json5 conversion output)
# would be a second config file and Renovate errors on finding two.
/renovate.json

# envtest control-plane binaries, fetched on demand by `make envtest-assets`.
.envtest/

# Local agent-session state: opencode config, notes and workflow residue.
# Never project source; every checkout carries its own.
.opencode/
.claude/
